{
  "name": "Schedule Compass",
  "short_name": "Schedule Compass",
  "description": "A weekly planner for college students that builds every day around classes, credits, work shifts and sleep, with a new affirmation every day.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#FFF7F4",
  "theme_color": "#2B4570",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["education", "productivity", "lifestyle"],
  "icons": [
    { "src": "icon-48.png",  "sizes": "48x48",   "type": "image/png" },
    { "src": "icon-72.png",  "sizes": "72x72",   "type": "image/png" },
    { "src": "icon-96.png",  "sizes": "96x96",   "type": "image/png" },
    { "src": "icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
